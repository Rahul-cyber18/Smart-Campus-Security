    <color name="on_background">#FFFFFFFF</color>
    <color name="on_surface">#FFFFFFFF</color>
    <color name="on_error">#FF000000</color>
    
    <!-- Control Button Colors -->
    <color name="forward_color">#FF4CAF50</color>
    <color name="backward_color">#FFF44336</color>
    <color name="left_color">#FF2196F3</color>
    <color name="right_color">#FFFFC107</color>
    <color name="stop_color">#FF9E9E9E</color>
    
    <!-- Status Colors -->
    <color name="connected_green">#FF4CAF50</color>
    <color name="disconnected_red">#FFF44336</color>
