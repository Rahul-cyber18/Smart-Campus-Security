<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.RobotCarApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>
    
    <!-- Dark Theme Colors -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="dark_background">#FF121212</color>
    <color name="dark_surface">#FF1E1E1E</color>
    <color name="dark_card">#FF2C2C2C</color>
    <color name="primary">#FF03DAC5</color>
    <color name="primary_variant">#FF018786</color>
    <color name="secondary">#FFBB86FC</color>
    <color name="error">#FFCF6679</color>
    <color name="on_primary">#FF000000</color>
